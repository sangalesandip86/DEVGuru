{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/impact-plan.schema.json",
  "title": "Test impact plan — declared before any test-asset write (plan v3.1 §4.13 step 3)",
  "description": "CI compares `files[].path` with the actual diff; an undeclared changed file is a scope violation. UPDATE of a shared asset requires a usage scan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["story", "mode", "design_ref", "files", "scenario_map"],
  "properties": {
    "story": {"type": "string", "pattern": "^ST-\\d+$"},
    "change_set": {"type": "string"},
    "mode": {"enum": ["A_SURGICAL", "B_MIRROR", "C_GREENFIELD"]},
    "characterization": {"type": "boolean", "default": false,
      "description": "true = ADR 0004 §3 characterization mode; requires assumption_entry and forbids ac_refs-based verification"},
    "assumption_entry": {"type": "string"},
    "design_ref": {"type": "string", "description": "repo@sha:path of the frozen design (or 'none' in characterization mode)"},
    "design_ac_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "golden_samples": {"type": "array", "items": {"type": "string"}, "description": "repo@sha:path of samples mirrored"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "kind"],
        "properties": {
          "path": {"type": "string"},
          "action": {"enum": ["CREATE", "UPDATE", "REUSE"]},
          "kind": {"enum": ["fixture", "builder", "page-object", "robot", "step-def", "spec", "mock", "feature", "config", "snapshot", "secrets-manifest"]},
          "shared": {"type": "boolean", "default": false},
          "usage_scan": {
            "type": "object",
            "required": ["command", "dependents"],
            "properties": {
              "command": {"type": "string"},
              "dependents": {"type": "array", "items": {"type": "string"}}
            }
          },
          "reason": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"action": {"const": "UPDATE"}, "shared": {"const": true}}, "required": ["action", "shared"]},
           "then": {"required": ["usage_scan", "reason"]}},
          {"if": {"properties": {"kind": {"const": "feature"}, "action": {"enum": ["CREATE", "UPDATE"]}}, "required": ["kind", "action"]},
           "then": {"not": {}, "description": "feature files are qa-derive's oracle; test-engineer may only REUSE them"}}
        ]
      }
    },
    "scenario_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "test"],
        "properties": {
          "scenario": {"type": "string", "pattern": "^ST-\\d+/SC-\\d+$"},
          "test": {"type": "string", "description": "file::test name"},
          "tier": {"enum": ["unit", "component", "contract", "bdd", "e2e"]}
        }
      }
    },
    "testability_requests": {
      "type": "array",
      "description": "locator/key hooks proposed to developer (never applied by test-engineer)",
      "items": {"type": "object", "required": ["file", "element", "proposed_hook"],
        "properties": {"file": {"type": "string"}, "element": {"type": "string"}, "proposed_hook": {"type": "string"}}}
    }
  }
}
