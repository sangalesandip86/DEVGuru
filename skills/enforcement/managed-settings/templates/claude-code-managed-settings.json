{
  "$comment": "GENERATED by skills/enforcement/managed-settings/generate_deny_list.py from control-file-paths.json \u2014 do not hand-edit. Deploy to the OS managed-settings location (admin-owned); replace {{ADLC_ENFORCEMENT_DIR}}.",
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/agents/**)",
      "Write(.github/agents/**)",
      "Edit(.github/skills/**)",
      "Write(.github/skills/**)",
      "Edit(.github/instructions/**)",
      "Write(.github/instructions/**)",
      "Edit(.github/copilot-instructions.md)",
      "Write(.github/copilot-instructions.md)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.github/hooks/**)",
      "Write(.github/hooks/**)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)",
      "Edit(**/.mcp.json)",
      "Write(**/.mcp.json)",
      "Edit(.vscode/mcp.json)",
      "Write(.vscode/mcp.json)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(**/AGENTS.md)",
      "Write(**/AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(CLAUDE.local.md)",
      "Write(CLAUDE.local.md)",
      "Edit(**/CLAUDE.local.md)",
      "Write(**/CLAUDE.local.md)",
      "Edit(CODEOWNERS)",
      "Write(CODEOWNERS)",
      "Edit(.github/CODEOWNERS)",
      "Write(.github/CODEOWNERS)",
      "Edit(docs/CODEOWNERS)",
      "Write(docs/CODEOWNERS)",
      "Edit(.github/rulesets/**)",
      "Write(.github/rulesets/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.gitlab-ci.yml)",
      "Write(.gitlab-ci.yml)",
      "Edit(azure-pipelines.yml)",
      "Write(azure-pipelines.yml)",
      "Edit(Jenkinsfile)",
      "Write(Jenkinsfile)",
      "Edit(skills/**)",
      "Write(skills/**)",
      "Edit(dist/**)",
      "Write(dist/**)",
      "Edit(skills/product-planning/policies/**)",
      "Write(skills/product-planning/policies/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{ADLC_ENFORCEMENT_DIR}}/hooks/config-change-logger/config_change_logger.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"{{ADLC_ENFORCEMENT_DIR}}/hooks/control-file-guard/control_file_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|Grep|Glob|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{ADLC_ENFORCEMENT_DIR}}/hooks/fact-writer-hooks/fact_writer.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
