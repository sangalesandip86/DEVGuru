{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/milestone.schema.json",
  "title": "Milestone (MS-n)",
  "description": "Plan files never carry a status: status is derived by the planning gates and recorded in the Evidence Ledger (plan v3.1 §4.12). additionalProperties:false makes a 'status' field a schema error. A milestone is an outcome checkpoint on the TIME axis: it groups epics and stories many-to-many and is never a level of the scope tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "objective",
    "business_outcome",
    "success_criteria",
    "exit_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MS-\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "business_outcome": {
      "type": "string",
      "minLength": 5,
      "description": "What a user or the business can do or observe once reached - never a technical layer"
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "epic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EPIC-\\d+$"
      }
    },
    "story_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ST-\\d+$"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MS-\\d+/EX-\\d+$"
          },
          "description": {
            "type": "string"
          },
          "check": {
            "enum": [
              "STRUCTURAL",
              "JUDGMENT",
              "APPROVAL"
            ]
          },
          "role": {
            "type": "string"
          },
          "approver": {
            "type": "string",
            "pattern": "^human:[a-z-]+$"
          }
        }
      }
    },
    "target_release": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": [
        "ref",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "ST-n, EPIC-n, MS-n, a contract id, or an external system/team"
        },
        "kind": {
          "enum": [
            "story",
            "epic",
            "contract",
            "external",
            "data",
            "environment",
            "team"
          ]
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "ACCEPTED_RISK"
          ]
        },
        "evidence_level": {
          "enum": [
            "DECLARED",
            "STATIC",
            "OBSERVED"
          ]
        },
        "owner": {
          "type": "string",
          "description": "Required when status is ACCEPTED_RISK: the human (human:<role>) who accepted the risk"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
