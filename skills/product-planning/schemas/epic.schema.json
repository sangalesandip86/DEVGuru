{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/epic.schema.json",
  "title": "Epic (EPIC-n)",
  "description": "Plan files never carry a status: status is derived by the planning gates and recorded in the Evidence Ledger (plan v3.1 §4.12). additionalProperties:false makes a 'status' field a schema error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "requirement_id",
    "objective",
    "business_outcome",
    "scope",
    "out_of_scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EPIC-\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-\\d+$"
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "business_outcome": {
      "type": "string",
      "minLength": 5
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "description": "Optional grouping level (plan v3.1 §4.12). Features live inside their epic and have no file of their own.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FEAT-\\d+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "milestone_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MS-\\d+$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "ref",
        "trust_level"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "repo@sha:path, issue URL, doc URL, or the ledger ENTRY-id of a recorded user statement"
        },
        "trust_level": {
          "enum": [
            "SYSTEM",
            "ORGANIZATIONAL",
            "REPOSITORY",
            "EXTERNAL_STRUCTURED",
            "EXTERNAL_UNSTRUCTURED"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "ref",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "ST-n, EPIC-n, MS-n, a contract id, or an external system/team"
        },
        "kind": {
          "enum": [
            "story",
            "epic",
            "contract",
            "external",
            "data",
            "environment",
            "team"
          ]
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "ACCEPTED_RISK"
          ]
        },
        "evidence_level": {
          "enum": [
            "DECLARED",
            "STATIC",
            "OBSERVED"
          ]
        },
        "owner": {
          "type": "string",
          "description": "Required when status is ACCEPTED_RISK: the human (human:<role>) who accepted the risk"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
