{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/requirement.schema.json",
  "title": "Requirement (REQ-n)",
  "description": "Plan files never carry a status: status is derived by the planning gates and recorded in the Evidence Ledger (plan v3.1 §4.12). additionalProperties:false makes a 'status' field a schema error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "statement",
    "requested_by",
    "source_refs",
    "business_outcome"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "description": "The request restated in neutral terms. Verbatim customer text stays in the referenced source, never here."
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "business_outcome": {
      "type": "string",
      "minLength": 5
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ENTRY-[A-Za-z0-9-]+$"
      },
      "description": "Ledger QUESTION entry ids"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ENTRY-[A-Za-z0-9-]+$"
      },
      "description": "Ledger ASSUMPTION entry ids"
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "ref",
        "trust_level"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "repo@sha:path, issue URL, doc URL, or the ledger ENTRY-id of a recorded user statement"
        },
        "trust_level": {
          "enum": [
            "SYSTEM",
            "ORGANIZATIONAL",
            "REPOSITORY",
            "EXTERNAL_STRUCTURED",
            "EXTERNAL_UNSTRUCTURED"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
