{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/incident.schema.json",
  "title": "Self-Improvement Incident (signal only)",
  "description": "ADR 0006. An incident carries a signal and local ledger pointers only: no task text, files, or free-text use-case content. The only prose is an optional sanitized note (<=280 chars) by the reviewer or human who caught the failure. This schema defines the application-level JSON format; the SQLite storage format is defined by the migration code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id", "skill", "step", "signal_type", "signal_source",
    "agent_role", "pattern_eligible", "evidence_refs",
    "platform_release_sha", "recorded_at", "status"
  ],
  "x-not-equal": [["agent_role", "note_author_role"]],
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC-[0-9A-Za-z]+$" },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Catalog path under skills/, e.g. product-planning/story-writer."
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Heading or numbered step of that skill's SKILL.md."
    },
    "failure_class": {
      "enum": [
        null,
        "INCOMPLETE_ARTIFACT", "UNTESTABLE_CRITERIA", "MISSING_NEGATIVE_CASE",
        "TRACEABILITY_GAP", "UNRESOLVED_DEPENDENCY", "UNRESOLVED_AMBIGUITY",
        "OVERSIZED_CHANGE", "MISSING_SAFEGUARD", "UNDECLARED_DEVIATION",
        "SCOPE_CREEP", "UNAUTHORIZED_ACTION", "WEAKENED_TEST",
        "INEFFECTIVE_TEST", "NONDETERMINISTIC_TEST", "SENSITIVE_DATA_EXPOSURE",
        "UNSOURCED_CLAIM", "INVALID_OUTPUT", "INCORRECT_BEHAVIOR",
        "DESIGN_DEFECT", "NON_CONVERGENCE"
      ],
      "description": "From failure-class-map.json. Required for negative/production signals; null for positive/efficiency."
    },
    "signal_type": {
      "enum": ["negative", "positive", "unverified-positive", "efficiency", "production"]
    },
    "signal_source": {
      "enum": ["AGENT", "REVIEWER", "HUMAN", "PRODUCTION"]
    },
    "check_id": {
      "type": ["string", "null"],
      "description": "The automated check id from failure-class-map.json, e.g. dor:negative_ac. Null for judgment-only failures."
    },
    "agent_role": {
      "enum": [
        "product-owner", "product-planner", "architect", "developer",
        "qa-derive", "qa-diagnose", "test-engineer",
        "security-reviewer", "code-reviewer"
      ],
      "description": "Role of the agent whose work is being recorded."
    },
    "verification_strength": {
      "type": ["object", "null"],
      "properties": {
        "changed_code_coverage": { "type": ["number", "null"] },
        "acceptance_criteria_exercised": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Strength of the verification that detected this signal."
    },
    "pattern_eligible": {
      "type": "boolean",
      "description": "Whether this incident can contribute to pattern detection. unverified-positive signals are never pattern_eligible."
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ENTRY-" },
      "minItems": 1,
      "description": "Entry IDs in this project's evidence ledger. At least one required."
    },
    "note": {
      "type": ["string", "null"],
      "maxLength": 280,
      "description": "One-line sanitized note for judgment-only failures. Never authored by the failing agent."
    },
    "note_author_role": {
      "type": ["string", "null"],
      "description": "Role of the note author (present when note is set). Must differ from agent_role."
    },
    "note_sanitize": {
      "type": ["object", "null"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "checked_at": { "type": ["string", "null"] }
      },
      "required": ["result", "checked_at"],
      "additionalProperties": false,
      "description": "Sanitization check result for the note field."
    },
    "platform_release_sha": { "type": "string" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["OPEN", "PATTERNED", "RESOLVED"] }
  },
  "allOf": [
    {
      "if": { "required": ["note"], "properties": { "note": { "type": "string" } } },
      "then": { "required": ["note_author_role", "note_sanitize"] }
    },
    {
      "if": { "properties": { "check_id": { "const": null } }, "required": ["check_id"] },
      "then": { "required": ["note", "note_author_role", "note_sanitize"] }
    },
    {
      "if": { "properties": { "signal_type": { "enum": ["negative", "production"] } } },
      "then": { "properties": { "failure_class": { "type": "string" } }, "required": ["failure_class"] }
    },
    {
      "if": { "properties": { "signal_type": { "enum": ["positive", "unverified-positive", "efficiency"] } } },
      "then": { "properties": { "failure_class": { "const": null } } }
    },
    {
      "if": { "properties": { "signal_type": { "const": "unverified-positive" } } },
      "then": { "properties": { "pattern_eligible": { "const": false } } }
    }
  ]
}
