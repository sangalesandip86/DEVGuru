{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schemas/ledger-entry.schema.json",
  "title": "Evidence Ledger Entry",
  "description": "One append-only, hash-chained entry in the Evidence Ledger (plan §4.3). Fields marked server-derived in the description are rejected if supplied by a caller. Canonical source: evidence_ledger/store.py + domain.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "run_id",
    "actor_type",
    "actor_id",
    "tool",
    "classification",
    "trust_level",
    "source_type",
    "platform_release_sha",
    "timestamp",
    "prev_hash",
    "row_hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "description": "Auto-increment primary key (server-assigned)."
    },
    "entry_id": {
      "type": "string",
      "pattern": "^ENTRY-[0-9A-Za-z]+$",
      "description": "Server-assigned."
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "change_set_id": {
      "type": ["string", "null"],
      "description": "Null for platform-level operations; forge-native form is <owner>/<repo>#<issue>."
    },
    "actor_type": {
      "enum": ["HUMAN", "AGENT", "SYSTEM"],
      "description": "Server-derived."
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "description": "Server-derived."
    },
    "agent_role": {
      "enum": [
        "product-owner", "product-planner", "architect", "developer",
        "qa-derive", "qa-diagnose", "test-engineer",
        "security-reviewer", "code-reviewer"
      ],
      "description": "Server-derived; present only when actor_type is AGENT."
    },
    "model_id": {
      "type": ["string", "null"]
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "description": "Server-derived from credential or SYSTEM writer."
    },
    "classification": {
      "enum": ["FACT", "INFERENCE", "ASSUMPTION", "PROPOSAL", "QUESTION", "DECISION", "RISK"]
    },
    "trust_level": {
      "enum": ["SYSTEM", "ORGANIZATIONAL", "REPOSITORY", "EXTERNAL_STRUCTURED", "EXTERNAL_UNSTRUCTURED"],
      "description": "Server-derived from source_type via SOURCE_TYPE_TRUST map; never caller-supplied."
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "description": "Inline content (pre-migration-0002) or empty string (post-0002, payload in evidence_content)."
    },
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Salted commitment (migration 0002). Null for pre-0002 entries."
    },
    "source": {
      "type": ["string", "null"]
    },
    "input_references": {
      "type": ["string", "null"],
      "description": "JSON array of entry_ids (stored as TEXT in SQLite)."
    },
    "output_references": {
      "type": ["string", "null"],
      "description": "JSON array (stored as TEXT in SQLite)."
    },
    "decision_ids": {
      "type": ["string", "null"],
      "description": "JSON array of entry_ids (stored as TEXT in SQLite)."
    },
    "lifecycle_state": {
      "enum": ["DRAFT", "PROPOSED", "REVIEWED", "VERIFIED", "APPROVED", "REJECTED"],
      "description": "Applies only to DECISION and PROPOSAL entries."
    },
    "snapshot_id": {
      "type": ["string", "null"]
    },
    "parent_entry_id": {
      "type": ["string", "null"],
      "pattern": "^ENTRY-[0-9A-Za-z]+$"
    },
    "outcome_status": {
      "enum": ["CHALLENGED", "ANSWERED"],
      "description": "CHALLENGED for corrections, ANSWERED for question responses."
    },
    "platform_release_sha": {
      "type": "string",
      "description": "Git SHA or 'unversioned'."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signal_source": {
      "enum": ["AGENT", "REVIEWER", "HUMAN", "PRODUCTION"]
    },
    "metadata": {
      "type": ["string", "null"],
      "description": "JSON object stored as TEXT. QUESTION: {blocking: bool}. ASSUMPTION: {impact, expires_at}."
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "classification": { "const": "FACT" } } },
      "then": {
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "actor_type": { "not": { "const": "AGENT" } }
        }
      }
    },
    {
      "if": { "properties": { "classification": { "const": "INFERENCE" } } },
      "then": {
        "required": ["input_references"],
        "properties": { "input_references": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": { "properties": { "actor_type": { "const": "AGENT" } } },
      "then": { "required": ["agent_role", "model_id"] }
    },
    {
      "if": {
        "required": ["lifecycle_state"],
        "properties": { "lifecycle_state": { "const": "VERIFIED" } }
      },
      "then": { "properties": { "actor_type": { "const": "SYSTEM" } } }
    },
    {
      "if": {
        "required": ["lifecycle_state"],
        "properties": { "lifecycle_state": { "const": "APPROVED" } }
      },
      "then": { "properties": { "actor_type": { "const": "HUMAN" } } }
    },
    {
      "if": { "required": ["outcome_status"] },
      "then": { "required": ["parent_entry_id"] }
    }
  ]
}
